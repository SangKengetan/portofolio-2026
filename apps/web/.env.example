# Copy to .env.local. Never commit .env.local.

# Base URL of the Express API (without /v1). Leave empty to use the built-in mock data.
API_URL=http://localhost:4000
# Same URL for the browser: contact form + the /admin panel. Required for /admin.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public site URL (used for metadata, sitemap and JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Host that serves /uploads/* for next/image — "domain.com" or a full URL (e.g. https://media.domain.com).
# API_URL is allowed automatically, so this can stay empty in development.
NEXT_PUBLIC_MEDIA_HOST=
# Shared secret for POST /api/revalidate — must equal REVALIDATE_SECRET in apps/api/.env
REVALIDATE_SECRET=change-me
