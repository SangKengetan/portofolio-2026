# Salin ke apps/api/.env lalu sesuaikan. JANGAN commit file .env.
# Variabel kosong ("KEY=") dianggap tidak diisi. Env asli proses selalu menang atas file ini.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Jumlah reverse proxy di depan API (Nginx = 1) supaya IP klien di rate limit benar.
TRUST_PROXY=0

# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgresql://portfolio:change-me@localhost:5432/portfolio
DB_POOL_MAX=10

# --- Web / CORS / CSRF ---
# Origin frontend (pisahkan koma). Di production wajib https://
WEB_ORIGIN=http://localhost:3000
# URL publik untuk membentuk URL media absolut (host yang menyajikan /uploads/*).
MEDIA_PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=./uploads
# Dev: Express menyajikan /uploads. Production: Nginx yang menyajikan folder itu.
# SERVE_UPLOADS=true
# Swagger UI di /docs (default: hanya non-production).
# DOCS_ENABLED=true

# --- Auth ---
# Acak & panjang: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-pakai-openssl-rand-base64-48
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_DOMAIN=.example.com
# Default: true di production, false di dev.
# COOKIE_SECURE=true
# Untuk meng-hash IP (rate limit & kontak) — tidak pernah menyimpan IP mentah.
IP_HASH_SECRET=change-me-pakai-openssl-rand-base64-48

# --- Revalidate Next.js (opsional; kosongkan untuk menonaktifkan) ---
# Harus sama dengan REVALIDATE_SECRET di apps/web.
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-samakan-dengan-apps-web

# --- Email notifikasi pesan kontak (opsional) ---
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Portfolio <no-reply@localhost>"
# CONTACT_NOTIFY_TO=you@example.com

# --- GitHub contributions (opsional) ---
# Token read-only (scope: read:user). Tanpa ini endpoint /v1/github/contributions memberi 503.
# GITHUB_TOKEN=
# GITHUB_USERNAME=

# --- Hanya untuk script seed:admin ---
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=minimal-12-karakter
# ADMIN_NAME=Admin
